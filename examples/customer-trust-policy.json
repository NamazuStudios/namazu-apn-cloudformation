{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CrossAccountIdentityEnforcement",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::308044622771:root"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:SetSourceIdentity"
      ],
      "Condition": {
        "StringEquals": {
          "sts:SourceIdentity": "${aws:ResourceTag/AuthorizedUser}"
        }
      }
    }
  ]
}
